# Cadena de conexión a Postgres (Neon) con soporte pgvector.
# Ejemplo de formato Neon: postgresql://usuario:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://usuario:password@host/dbname?sslmode=require

# API key de Anthropic (Claude), usada por el agente RAG (app/agent.py).
ANTHROPIC_API_KEY=sk-ant-placeholder

# API key de Voyage AI, usada para generar embeddings (app/embeddings.py).
# Anthropic no tiene API de embeddings propia; Voyage AI es su partner recomendado.
VOYAGE_API_KEY=pa-placeholder

# API key simple que debe enviarse en el header X-API-Key para llamar a
# POST /ingesta/norma (app/main.py). Si esta variable no está configurada,
# el endpoint rechaza TODOS los requests (falla cerrado).
INGESTA_API_KEY=cambia-este-valor

# Opcionales: modelo y dimensión de embedding. Deben coincidir con EMBEDDING_DIM
# en app/models.py y con la columna `embedding` de la migración de la tabla `norma`.
VOYAGE_EMBEDDING_MODEL=voyage-3.5
VOYAGE_EMBEDDING_DIM=1024

# Orígenes permitidos por CORS (separados por comas) para que el frontend
# (frontend/, React + Vite) pueda llamar a /consulta, /consulta-sfc y
# /norma/{id} desde el navegador. Por defecto solo habilita el puerto de
# desarrollo de Vite en localhost — agregar aquí la URL real donde quede
# publicado el frontend en producción.
#
# Si corrés el backend DENTRO de un Codespace y accedés al frontend por su
# puerto reenviado (no localhost:5173 directo), agregá también ese origen,
# con el patrón https://<CODESPACE_NAME>-5173.app.github.dev — ej.:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,https://jubilant-goggles-jjj5xv566w6625v95-5173.app.github.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
